#!/bin/sh
# Platform dispatcher: downloads (once) and runs the binary matching this
# machine, from this repo's own GitHub Releases.
#
# This exists so installing the plugin is `git clone` (or `git pull`) and
# nothing else: no Go toolchain, no build step, no interpreter. Binaries are
# NOT committed to this repo (they used to be -- that grew git history by
# ~12MB per release forever, unreclaimable without a history rewrite); this
# script fetches the matching one from the latest GitHub Release on first
# run and caches it beside itself, so every run after the first is a plain
# local exec with no network involved.
#
# hooks.json and the statusLine command both reference THIS path, so the
# name must stay stable; the per-platform binaries carry the suffix.
#
# Claude Code runs hook/statusline commands through a POSIX shell on every
# platform, including Windows (Git Bash, not PowerShell or cmd), so a plain
# /bin/sh script is portable here in a way a .bat/.ps1 pair would not be.

set -e

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo="case-forge/cache-ttl-tracker"

case "$(uname -s)" in
	Linux*)  os=linux ;;
	Darwin*) os=darwin ;;
	MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
	*) echo "cache-ttl-tracker: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
	x86_64|amd64)  arch=amd64 ;;
	arm64|aarch64) arch=arm64 ;;
	*) echo "cache-ttl-tracker: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

ext=
[ "$os" = windows ] && ext=.exe

binary="$dir/cache-ttl-tracker-$os-$arch$ext"

if [ ! -x "$binary" ]; then
	url="https://github.com/$repo/releases/latest/download/cache-ttl-tracker-$os-$arch$ext"

	if command -v curl >/dev/null 2>&1; then
		fetch="curl -fsSL -o"
	elif command -v wget >/dev/null 2>&1; then
		fetch="wget -q -O"
	else
		echo "cache-ttl-tracker: no binary at $binary and neither curl nor wget is available to fetch one" >&2
		echo "cache-ttl-tracker: download it yourself from $url and save it to that path" >&2
		exit 1
	fi

	echo "cache-ttl-tracker: first run for $os/$arch, downloading from $url" >&2
	tmp="$binary.download"
	if ! $fetch "$tmp" "$url"; then
		rm -f "$tmp"
		echo "cache-ttl-tracker: download failed ($url)" >&2
		echo "cache-ttl-tracker: check network access, or build one with:" >&2
		echo "  go build -ldflags=\"-s -w\" -o \"$binary\" ./cmd/cache-ttl-tracker" >&2
		exit 1
	fi
	chmod +x "$tmp"
	mv "$tmp" "$binary"
fi

exec "$binary" "$@"
